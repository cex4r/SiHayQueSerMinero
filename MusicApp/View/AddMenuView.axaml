<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicApp.View.AddMenuView">
  <Border Classes="card" Width="480">
    <StackPanel Spacing="14">
      <Grid>
        <TextBlock Text="Add" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
        <Button Classes="back" Content="Back" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnBack" />
      </Grid>
      <Button Classes="menuitem" Content="Artist" Click="OnArtist" />
      <Button Classes="menuitem" Content="Song" Click="OnSong" />
      <Button Classes="menuitem" Content="Album" Click="OnAlbum" />
    </StackPanel>
  </Border>
</UserControl>
