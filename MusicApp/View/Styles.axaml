<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="Black" />
  </Style>

  <Style Selector="UserControl">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Botones -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="18,7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#00BF63" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#00D870" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="#555555" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#6A6A6A" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.back">
    <Setter Property="Background" Value="Black" />
  </Style>
  <Style Selector="Button.back:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#222222" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.menuitem">
    <Setter Property="Background" Value="#A6A6A6" />
    <Setter Property="Foreground" Value="#555555" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0,16" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#BDBDBD" />
    <Setter Property="Foreground" Value="#444444" />
  </Style>

  <!-- Navegación inferior -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#626262" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="#707070" />
  </Style>
  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#707070" />
  </Style>

  <!-- Campos de texto -->
  <Style Selector="TextBox">
    <Style.Resources>
      <SolidColorBrush x:Key="TextControlBackground" Color="#303030" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#363636" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#363636" />
    </Style.Resources>
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Selector de tipo de intérprete -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="#303030" />
    <Setter Property="BorderBrush" Value="#A0A0A0" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="18,6" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#00BF63" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Paneles y listas -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="#555555" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="24" />
  </Style>
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="#0F0F0F" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="#FF7B7B" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="#B3B3B3" />
  </Style>

</Styles>
